# Single server: Next.js pages + NestJS API (under /api) on one port
PORT=3000

# PostgreSQL - the existing accountex database (multi-schema: Company, Platform, Lookups, ...)
DATABASE_URL="postgresql://postgres:<password>@localhost:5434/accountex"

# Auth - use a long random value in production
JWT_SECRET="change-me-to-a-long-random-string"

# AES-256-GCM key for tenant secrets (FBR/PRA tokens): 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes stored tokens unreadable (they must be entered again).
APP_ENCRYPTION_KEY=

# Super Admin portal (/admin) - separate secret, must differ from JWT_SECRET
ADMIN_JWT_SECRET="change-me-to-another-long-random-string"

# Seed data (no registration screens) - created by: npm run db:seed
# The single platform admin who signs in at /admin/login
ADMIN_EMAIL="superadmin@accountex.local"
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD="change-me-please"

# Demo tenant and its first user (gets the Admin role)
SEED_TENANT_NAME="Demo Company"
SEED_TENANT_CODE="demo"
SEED_USER_EMAIL="admin@accountex.local"
SEED_USER_NAME="Admin"
SEED_USER_PASSWORD="change-me-please"

# Phase 38: on-demand backups (System Health > Backups). pg_dump writes here; a relative path is under the project root.
BACKUP_DIR="./backups"
# pg_dump of PostgreSQL 18 (default on Windows: C:\Program Files\PostgreSQL\18\bin\pg_dump.exe)
# PG_DUMP_PATH="C:\Program Files\PostgreSQL\18\bin\pg_dump.exe"
# Phase 41: the daily billing run (renewal invoices, dunning cases, PAST_DUE -> READ_ONLY -> SUSPENDED). "off" disables
# its timer; "Run now" in the Super Admin still works.
# BILLING_JOB="off"

# Phase 32: uploaded files (tax declaration proofs; Phase 35 extends it). A relative path is under the project root; git-ignored.
UPLOAD_DIR="./uploads"

# Phase 43: hourly ops job (applies approved flag change requests once their time comes, opens requests for due ramp steps). off = disabled.
# OPS_JOB=off

# Phase 28: FBR Digital Invoicing. Sending is switched on per company in Tax > FBR Integration (off by default).
# Company codes listed here use a local simulator instead of FBR (tests only; invoice numbers start with SIM-).
# FBR_SIMULATE_TENANTS="test"
