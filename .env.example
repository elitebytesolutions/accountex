# Single server: Next.js pages + NestJS API (under /api) on one port
PORT=3000

# PostgreSQL - the existing accountex database (multi-schema: Company, Platform, Lookups, ...)
DATABASE_URL="postgresql://postgres:<password>@localhost:5434/accountex"

# Auth - use a long random value in production
JWT_SECRET="change-me-to-a-long-random-string"

# AES-256-GCM key for tenant secrets (FBR/PRA tokens): 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes stored tokens unreadable (they must be entered again).
APP_ENCRYPTION_KEY=

# Super Admin portal (/admin) - separate secret, must differ from JWT_SECRET
ADMIN_JWT_SECRET="change-me-to-another-long-random-string"

# Seed data (no registration screens) - created by: npm run db:seed
# The single platform admin who signs in at /admin/login
ADMIN_EMAIL="superadmin@accountex.local"
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD="change-me-please"

# Demo tenant and its first user (gets the Admin role)
SEED_TENANT_NAME="Demo Company"
SEED_TENANT_CODE="demo"
SEED_USER_EMAIL="admin@accountex.local"
SEED_USER_NAME="Admin"
SEED_USER_PASSWORD="change-me-please"
