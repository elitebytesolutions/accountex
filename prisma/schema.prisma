  workingWeek                      String     @default("MON_SAT_HALF_SAT")
  graceMinutes                     Int        @default(15) @db.SmallInt
  lateMarksPerLeave                Int        @default(3) @db.SmallInt
  halfDayBelowHours                Decimal    @default(5) @db.Decimal(4, 2)
  overtimeMultiplier               Decimal    @default(2) @db.Decimal(4, 2)
  attendanceSource                 String     @default("BIOMETRIC_AND_ESS")
  geofenceEssPunch                 Boolean    @default(true)
  allowOffsitePersonalPunch        Boolean    @default(false)
  createdAt                        DateTime   @default(now()) @db.Timestamptz(6)
  createdBy                        String?    @db.Uuid
  updatedAt                        DateTime   @default(now()) @db.Timestamptz(6)
  updatedBy                        String?    @db.Uuid
  rowVersion                       Int        @default(0)
  Currencies                       Currencies @relation(fields: [baseCurrencyCode], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@schema("Company")
