  taxCodeId           String?   @db.Uuid
  taxRate             Decimal   @default(0) @db.Decimal(7, 4)
  taxAmount           Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount         Decimal   @db.Decimal(18, 2)
  whtSection          String?
  whtRate             Decimal   @default(0) @db.Decimal(7, 4)
  whtAmount           Decimal   @default(0) @db.Decimal(18, 2)
  netUnitCost         Decimal?  @default(dbgenerated("\nCASE\n    WHEN (((\"baseQty\" + \"bonusQty\") - \"breakageQty\") > (0)::numeric) THEN round((\"netAmount\" / ((\"baseQty\" + \"bonusQty\") - \"breakageQty\")), 4)\n    ELSE NULL::numeric\nEND")) @db.Decimal(18, 4)
  batchId             String?   @db.Uuid
  batchNo             String?
  expiryDate          DateTime? @db.Date
  costCentreId        String?   @db.Uuid
  projectId           String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  createdBy           String?   @db.Uuid
  updatedAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedBy           String?   @db.Uuid
  rowVersion          Int       @default(0)

  @@unique([tenantId, billId, lineNo], map: "billLineNoUk")
  @@unique([tenantId, id], map: "billLineTenantIdUk")
  @@schema("Purchases")
}

