// Mapped from the existing accountex database - the database is the source of truth.
// Do NOT run `prisma migrate`: change the database with SQL (prisma/sql/*.sql, applied with
// `npx prisma db execute --file <file>`), then copy the model from `prisma db pull` output.
// Only tables the code uses are mapped here; add more as features need them.
// No enums: fixed lists live in Lookups.Lookups (validated by the Lookups.validateLookups trigger).

generator client {
  provider            = "prisma-client"
  output              = "../src/server/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["Accounting", "BankCash", "Company", "Distribution", "EmployeeSelfService", "FixedAssets", "HumanResources", "Inventory", "Lookups", "Payroll", "Platform", "Purchases", "Sales", "Tax", "Reports"]
}

model Permissions {
  code            String            @id
  module          String
  resource        String
  resourceLabel   String
  action          String
  description     String?
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  createdBy       String?           @db.Uuid
  updatedAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedBy       String?           @db.Uuid
  rowVersion      Int               @default(0)
  RolePermissions RolePermissions[]

  @@unique([resource, action])
  @@index([module, sortOrder], map: "permissionModuleIdx")
  @@schema("Company")
}

model RolePermissions {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @db.Uuid
  roleId         String      @db.Uuid
  permissionCode String
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  createdBy      String?     @db.Uuid
  updatedAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedBy      String?     @db.Uuid
  rowVersion     Int         @default(0)
  Permissions    Permissions @relation(fields: [permissionCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  Tenants        Tenants     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Roles          Roles       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, roleId, permissionCode])
  @@index([tenantId, permissionCode], map: "rolePermissionPermIdx")
  @@schema("Company")
}

model Roles {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @db.Uuid
  name             String            @db.Citext
  systemKey        String?
  description      String?
  icon             String?
  tone             String?
  isSystem         Boolean           @default(false)
  branchRestricted Boolean           @default(true)
  copiedFromRoleId String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  createdBy        String?           @db.Uuid
  updatedAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedBy        String?           @db.Uuid
  rowVersion       Int               @default(0)
  deletedAt        DateTime?         @db.Timestamptz(6)
  RolePermissions  RolePermissions[]
  Roles            Roles?            @relation("RolesToRoles", fields: [tenantId, copiedFromRoleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  other_Roles      Roles[]           @relation("RolesToRoles")
  Tenants          Tenants           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserRoles        UserRoles[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId, systemKey])
  @@schema("Company")
}

model UserRoles {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  createdBy  String?  @db.Uuid
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedBy  String?  @db.Uuid
  rowVersion Int      @default(0)
  Tenants    Tenants  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Roles      Roles    @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  Users      Users    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, userId, roleId])
  @@unique([tenantId, userId], map: "userRoleOnePrimaryIdx", where: raw("\"isPrimary\""))
  @@index([tenantId, roleId], map: "userRoleRoleIdx")
  @@schema("Company")
}

model Users {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @db.Uuid
  email              String                 @db.Citext
  passwordHash       String?
  mustChangePassword Boolean                @default(false)
  passwordChangedAt  DateTime?              @db.Timestamptz(6)
  firstName          String?
  lastName           String?
  fullName           String
  jobTitle           String?
  department         String?
  phone              String?
  avatarAttachmentId String?                @db.Uuid
  emailSignature     String?
  isExternal         Boolean                @default(false)
  externalOrg        String?
  status             String                 @default("INVITED")
  defaultBranchId    String?                @db.Uuid
  dataScope          String                 @default("BRANCH")
  moduleAccess       String[]               @default([])
  approvalLimit      Decimal                @default(0) @db.Decimal(18, 2)
  mfaEnabled         Boolean                @default(false)
  mfaMethod          String?
  mfaSecretEnc       Bytes?
  mfaRecoveryCodes   String[]
  ipRestricted       Boolean                @default(false)
  ipAllowlist        Unsupported("_cidr")[]
  sessionTimeoutMin  Int                    @default(60) @db.SmallInt
  loginHours         String                 @default("ANY")
  loginFrom          DateTime?              @db.Time(6)
  loginTo            DateTime?              @db.Time(6)
  ssoProvider        String?
  ssoSubject         String?
  failedLoginCount   Int                    @default(0) @db.SmallInt
  lockedUntil        DateTime?              @db.Timestamptz(6)
  invitedByUserId    String?                @db.Uuid
  invitedAt          DateTime?              @db.Timestamptz(6)
  activatedAt        DateTime?              @db.Timestamptz(6)
  suspendedAt        DateTime?              @db.Timestamptz(6)
  lastLoginAt        DateTime?              @db.Timestamptz(6)
  lastLoginIp        String?                @db.Inet
  lastActiveAt       DateTime?              @db.Timestamptz(6)
  employeeId         String?                @db.Uuid
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  createdBy          String?                @db.Uuid
  updatedAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedBy          String?                @db.Uuid
  rowVersion         Int                    @default(0)
  deletedAt          DateTime?              @db.Timestamptz(6)
  UserRoles          UserRoles[]
  Tenants            Tenants                @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Users              Users?                 @relation("UsersToUsers", fields: [tenantId, invitedByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  other_Users        Users[]                @relation("UsersToUsers")

  @@unique([tenantId, id])
  @@unique([tenantId, email], map: "appUserEmailUidx", where: raw("(status <> 'REMOVED'::text)"))
  @@unique([tenantId, employeeId], map: "appUserEmployeeUidx", where: raw("((\"employeeId\" IS NOT NULL) AND (status <> 'REMOVED'::text))"))
  @@unique([tenantId, ssoProvider, ssoSubject], map: "appUserSsoUidx", where: raw("(\"ssoProvider\" IS NOT NULL)"))
  @@index([fullName(ops: raw("gin_trgm_ops"))], map: "appUserNameTrgmIdx", type: Gin)
  @@index([tenantId, status], map: "appUserTenantStatusIdx")
  @@schema("Company")
}

model Lookups {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lookupType  String
  code        String
  label       String
  labelUrdu   String?
  description String?
  tone        String   @default("neutral")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  parentCodes String[]
  tenantId    String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdBy   String?  @db.Uuid
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedBy   String?  @db.Uuid
  rowVersion  Int      @default(0)
  Tenants     Tenants? @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([lookupType, code, tenantId], map: "lookupsTypeCodeTenantKey")
  @@index([tenantId, lookupType], map: "lookupsTenantIdx", where: raw("(\"tenantId\" IS NOT NULL)"))
  @@index([lookupType, sortOrder], map: "lookupsTypeIdx")
  @@schema("Lookups")
}

model PlatformAdmin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton    Boolean   @unique @default(true)
  email        String    @unique @db.Citext
  fullName     String
  passwordHash String
  lastLoginAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  createdBy    String?   @db.Uuid
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedBy    String?   @db.Uuid
  rowVersion   Int       @default(0)

  @@schema("Platform")
}

model Tenants {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String            @unique @db.Citext
  subdomain            String            @unique @db.Citext
  displayName          String
  legalName            String
  ntn                  String?
  strn                 String?
  secpRegNo            String?
  industry             String?
  country              String            @default("PK") @db.Char(2)
  city                 String?
  province             String?
  address              String?
  phone                String?
  email                String?           @db.Citext
  fiscalYearStartMonth Int               @default(7) @db.SmallInt
  baseCurrency         String            @default("PKR") @db.Char(3)
  timezone             String            @default("Asia/Karachi")
  numberFormat         String            @default("SOUTH_ASIAN")
  dateFormat           String            @default("DD MMM YYYY")
  dataResidency        String            @default("PK_LAHORE")
  coaTemplateId        String?           @db.Uuid
  requireMfa           Boolean           @default(false)
  allowSso             Boolean           @default(false)
  defaultLanguage      String            @default("EN")
  status               String            @default("PROVISIONING")
  /// The default user: holds every role, cannot be deactivated (Platform.provisionTenant, 006-tenant-provisioning.sql).
  defaultUserId        String?           @db.Uuid
  healthScore          Int?              @db.SmallInt
  trialEndsOn          DateTime?         @db.Date
  activatedAt          DateTime?         @db.Timestamptz(6)
  lastActiveAt         DateTime?         @db.Timestamptz(6)
  accountOwnerStaffId  String?           @db.Uuid
  appVersion           String?
  platforms            String[]          @default(["WEB"])
  isBeta               Boolean           @default(false)
  isInternal           Boolean           @default(false)
  salesTaxRegistered   Boolean?          @default(dbgenerated("(strn IS NOT NULL)"))
  healthFactors        Json?
  healthUpdatedAt      DateTime?         @db.Timestamptz(6)
  suspendedAt          DateTime?         @db.Timestamptz(6)
  suspensionReason     String?
  churnedAt            DateTime?         @db.Timestamptz(6)
  churnReason          String?
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  createdBy            String?           @db.Uuid
  updatedAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedBy            String?           @db.Uuid
  rowVersion           Int               @default(0)
  RolePermissions      RolePermissions[]
  Roles                Roles[]
  UserRoles            UserRoles[]
  Users                Users[]
  Lookups              Lookups[]

  @@index([churnedAt], map: "tenantChurnedAtIdx", where: raw("(\"churnedAt\" IS NOT NULL)"))
  @@index([displayName(ops: raw("gin_trgm_ops"))], map: "tenantNameTrgmIdx", type: Gin)
  @@index([province, city], map: "tenantProvinceCityIdx")
  @@index([status], map: "tenantStatusIdx")
  @@schema("Platform")
}

