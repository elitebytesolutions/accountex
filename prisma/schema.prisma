model Currencies {
  code            String            @id @db.Char(3)
  name            String
  symbol          String
  minorUnits      Int               @default(2) @db.SmallInt
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  createdBy       String?           @db.Uuid
  updatedAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedBy       String?           @db.Uuid
  rowVersion      Int               @default(0)
  CompanySettings CompanySettings[]
  ExchangeRates   ExchangeRates[]

  @@schema("Company")
}

model DocumentTypes {
  code               String            @id
  name               String
  module             String
  tableName          String?
  defaultPrefix      String
  defaultPattern     String            @default("{PREFIX}-{YYYY}-{SEQ6}")
  defaultPadding     Int               @default(6) @db.SmallInt
  defaultResetPolicy String            @default("YEARLY")
  isPostingDoc       Boolean           @default(false)
  isMaster           Boolean           @default(false)
  supportsApproval   Boolean           @default(false)
  sortOrder          Int               @default(0)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  createdBy          String?           @db.Uuid
  updatedAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedBy          String?           @db.Uuid
  rowVersion         Int               @default(0)
  NumberingSeries    NumberingSeries[]

  @@index([module, sortOrder], map: "docTypeModuleIdx")
  @@schema("Company")
}

model ExchangeRates {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @db.Uuid
  currencyCode String     @db.Char(3)
  rateDate     DateTime   @db.Date
  rate         Decimal    @db.Decimal(18, 6)
  source       String     @default("SBP")
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  createdBy    String?    @db.Uuid
  updatedAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedBy    String?    @db.Uuid
  rowVersion   Int        @default(0)
  Currencies   Currencies @relation(fields: [currencyCode], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, currencyCode, rateDate])
  @@unique([tenantId, id])
  @@schema("Company")
}

model NumberingSeries {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String                    @db.Uuid
  docType                 String
  branchId                String?                   @db.Uuid
  prefix                  String
  pattern                 String                    @default("{PREFIX}-{YYYY}-{SEQ6}")
  padding                 Int                       @default(6)
  startValue              BigInt                    @default(1)
  resetPolicy             String                    @default("YEARLY")
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  createdBy               String?                   @db.Uuid
  updatedAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedBy               String?                   @db.Uuid
  rowVersion              Int                       @default(0)
  DocumentTypes           DocumentTypes             @relation(fields: [docType], references: [code], onDelete: NoAction, onUpdate: NoAction)
  Branches                Branches?                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  NumberingSeriesCounters NumberingSeriesCounters[]

  @@unique([tenantId, docType, branchId])
  @@unique([tenantId, id])
  @@schema("Company")
}

model NumberingSeriesCounters {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @db.Uuid
  sequenceId      String          @db.Uuid
  periodKey       String
  nextValue       BigInt
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @db.Timestamptz(6)
  NumberingSeries NumberingSeries @relation(fields: [tenantId, sequenceId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, sequenceId, periodKey])
  @@schema("Company")
}

model SetupGuideSteps {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  stepKey      String
  isDone       Boolean   @default(false)
  doneAt       DateTime? @db.Timestamptz(6)
  doneByUserId String?   @db.Uuid
  autoDetected Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  createdBy    String?   @db.Uuid
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedBy    String?   @db.Uuid
  rowVersion   Int       @default(0)

  @@unique([tenantId, id])
  @@unique([tenantId, stepKey])
  @@schema("Company")
}

