  warnDuplicateVendorInvoice       Boolean    @default(true)
  stockAdjustmentApprovalThreshold Decimal    @default(25000) @db.Decimal(18, 2)
  gstRegistered                    Boolean    @default(true)
  salesTaxReturnPeriod             String     @default("MONTHLY")
  standardGstRatePct               Decimal    @default(18) @db.Decimal(7, 4)
  furtherTaxRatePct                Decimal    @default(4) @db.Decimal(7, 4)
  provincialTaxAuthority           String?
  provincialServicesRatePct        Decimal?   @db.Decimal(7, 4)
  atlStatus                        String     @default("UNKNOWN")
  atlVerifiedAt                    DateTime?  @db.Timestamptz(6)
  brandPrimaryColour               String     @default("#15803D")
  brandAccentColour                String     @default("#EFBC61")
  documentFont                     String     @default("INTER")
  paperSize                        String     @default("A4")
  emailFooter                      String?
  showPoweredBy                    Boolean    @default(true)
  fbrRealtimeReporting             Boolean    @default(false)
  printFbrQr                       Boolean    @default(false)
