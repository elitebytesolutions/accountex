model Branches {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @unique(map: "branchOneDefaultIdx", where: raw("(\"isDefault\" AND (\"deletedAt\" IS NULL))")) @db.Uuid
  code              String
  name              String
  description       String?
  isHeadOffice      Boolean           @default(false)
  isDefault         Boolean           @default(false)
  managerUserId     String?           @db.Uuid
  address           String?
  city              String?
  province          String?
  salesTaxAuthority String?
  phone             String?
  email             String?           @db.Citext
  openingDate       DateTime?         @db.Date
  status            String            @default("ACTIVE")
  managerEmployeeId String?           @db.Uuid
  latitude          Decimal?          @db.Decimal(9, 6)
  longitude         Decimal?          @db.Decimal(9, 6)
  geofenceRadiusM   Int?
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
